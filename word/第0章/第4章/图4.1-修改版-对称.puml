@startuml

left to right direction

actor "管理员端" as Admin
actor "用户端" as User

rectangle "古树名木多模态检索系统" {
    
    package "管理员功能" {
        usecase "古树名木信息管理" as UC1
        usecase "多模态检索管理" as UC2
        usecase "哈希索引管理" as UC2_1
        usecase "检索日志审计" as UC2_2
        usecase "用户管理" as UC3
        usecase "权限管理" as UC4
        usecase "登录" as UC5
    }
    
    package "用户功能" {
        usecase "注册" as UC6
        usecase "个人信息管理" as UC7
        usecase "多模态检索功能" as UC8
        usecase "以图搜图(I2I)" as UC8_1
        usecase "以图搜位置(I2L)" as UC8_2
        usecase "以位置搜图(L2I)" as UC8_3
        usecase "图像上传" as UC9
        usecase "按树种名称检索" as UC10
    }
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC8

UC2 ..> UC2_1 : <<include>>
UC2 ..> UC2_2 : <<include>>

User --> UC6
User --> UC7
User --> UC8
User --> UC9
User --> UC10

UC8 ..> UC8_1 : <<include>>
UC8 ..> UC8_2 : <<include>>
UC8 ..> UC8_3 : <<include>>

UC9 ..> UC8 : <<extend>>

note bottom of UC8
  <b>三种检索模式</b>
  I2I: 上传图像,检索相似图像
  I2L: 上传图像,检索返回位置  
  L2I: 输入坐标,检索附近图像
end note

note left of UC9
  上传图像可用于后续检索
end note

@enduml
