@startuml

'skinparam handwritten false

' 定义参与者
actor "用户" as User

participant "登录注册页" as LoginPage
participant "用户信息页" as UserPage
participant "UserController" as Controller
participant "IUserService" as Service
participant "UserMapper" as Mapper
participant "MySQL数据库" as DB

' 访问登录页面
User -> LoginPage: 访问登录注册页面
activate LoginPage

' 登录验证
User -> LoginPage: 输入用户名密码
LoginPage -> Controller: 调用/user/login接口(POST)
activate Controller
Controller -> Service: 调用login方法
activate Service
Service -> Mapper: 验证用户名密码
activate Mapper
Mapper -> DB: 查询用户信息
activate DB
DB --> Mapper: 返回用户数据
deactivate DB
Mapper --> Service: 验证结果
deactivate Mapper
Service --> Controller: 登录结果
deactivate Service

alt 登录失败或Cookie过期
    Controller --> LoginPage: 返回登录失败
    LoginPage --> User: 提示"未登录/过期请重新登录"
    deactivate Controller
    deactivate LoginPage
else 登录成功
    Controller --> LoginPage: 返回Token/Cookie
    deactivate Controller
    LoginPage --> User: 登录成功，进入系统
    deactivate LoginPage
    
    ' 查询用户信息
    User -> UserPage: 访问用户信息页面
    activate UserPage
    UserPage -> Controller: 调用/user/getUserInfo/{userId}接口(GET)
    activate Controller
    Controller -> Service: 调用getUserInfoByUserId方法
    activate Service
    Service -> Mapper: 调用selectUserInfoByUserId方法
    activate Mapper
    Mapper -> DB: 查询用户详情
    activate DB
    DB --> Mapper: 返回用户数据
    deactivate DB
    Mapper --> Service: 返回用户信息
    deactivate Mapper
    
    ' 角色判断
    Service -> Service: 判断用户角色
    
    alt 管理员角色
        Service -> Mapper: 查询全部用户列表
        activate Mapper
        Mapper -> DB: 执行全量查询
        activate DB
        DB --> Mapper: 返回全部用户
        deactivate DB
        Mapper --> Service: 返回用户列表
        deactivate Mapper
    else 普通用户
        Service -> Service: 根据userId查询当前用户
    end
    
    Service --> Controller: 返回用户信息(用户ID/登录名/用户名/角色等)
    deactivate Service
    Controller --> UserPage: 返回用户数据
    deactivate Controller
    UserPage --> User: 展示用户信息
    deactivate UserPage
end

' 注释说明
note right of Service
  <b>RBAC权限控制</b>
  管理员：可查看全部用户
  普通用户：仅查看自己信息
end note

note right of Controller
  <b>用户接口</b>
  /user/login：登录验证
  /user/getUserInfo/{userId}：获取用户信息
end note

@enduml
