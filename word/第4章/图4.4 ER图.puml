@startuml

skinparam backgroundColor #FFFFFF
left to right direction

' 间距控制
skinparam nodesep 35
skinparam ranksep 50

' 隐藏 stereotype（去掉 «diamond»）
hide stereotype

' 实体样式（蓝色系）
skinparam entity {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
    BorderThickness 1.5
}

' 类/菱形样式（黄色系）
skinparam class {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
    BorderThickness 1.5
}

' ===== 定义实体（与数据库表结构对齐） =====
entity "用户信息表" as User {
    * id : bigint <<PK>>
    --
    login_name : varchar(50)      '登录名'
    name : varchar(50)            '昵称/名称'
    password : char(32)           '密码（MD5加密）'
    age : int                     '年龄'
    desc : text                   '个人描述'
    per_role_id : bigint          '角色ID'
    is_delete : tinyint           '是否逻辑删除'
    create_time : bigint          '创建时间'
    update_time : bigint          '更新时间'
    last_login_time : bigint      '上次登录时间'
}

entity "权限角色表" as Role {
    * id : bigint <<PK>>
    --
    role_name : varchar(256)      '角色名称'
    permission_desc : text        '权限描述'
    is_delete : tinyint           '是否逻辑删除'
    create_time : bigint          '创建时间'
    update_time : bigint          '更新时间'
}

entity "树木表" as Tree {
    * id : bigint <<PK>>
    --
    tree_code : varchar(20)       '古树编号'
    name : varchar(100)           '古树名称'
    family : varchar(64)          '科'
    genus : varchar(64)           '属'
    species : varchar(256)        '树种名称'
    protection_level : varchar(20)'保护级别'
    age : int                     '树龄'
    height : varchar(64)          '树高'
    latitude : decimal(10,8)      '纬度'
    longitude : decimal(11,8)     '经度'
    desc : text                   '描述信息'
    is_delete : tinyint           '是否逻辑删除'
    create_time : bigint          '创建时间'
    update_time : bigint          '更新时间'
}

entity "图像表" as Image {
    * id : bigint <<PK>>
    --
    tree_id : bigint <<FK>>       '关联树木ID'
    image_path : varchar(256)     '图像存储路径'
    hash_code : varchar(128)      '128位哈希码'
    hash_bits : binary(16)        '16字节哈希位串'
    is_delete : tinyint           '是否逻辑删除'
    create_time : bigint          '创建时间'
    update_time : bigint          '更新时间'
}

' ===== 关系菱形（黄色背景） =====
class "属于" as BelongsTo #FFF9C4
class "管理" as ManageTree #FFF9C4
class "拥有" as Owns #FFF9C4

' ===== 关系连接（带 cardinality 标注） =====
Role "1" -- "N" BelongsTo
BelongsTo "N" -- "1" User

User "1" -- "N" ManageTree
ManageTree "N" -- "1" Tree

Tree "1" -- "N" Owns
Owns "N" -- "1" Image

' ===== 注释（浅黄背景） =====
note bottom of Image
图像信息表：
- hash_code: 128位哈希码字符串
- hash_bits: 16字节二进制存储
end note

note bottom of Tree
位置坐标采用WGS84坐标系，科属种字段支持三级级联检索：
- latitude: 纬度(-90~90)
- longitude: 经度(-180~180)
- family/genus/species: 科属种三级分类
- protection_level: 一级/二级/三级
end note

note bottom of User
用户信息表：
- login_name: 系统登录账号
- per_role_id: 外键关联权限角色表
end note

@enduml
