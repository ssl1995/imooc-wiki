@startuml

skinparam backgroundColor #FFFFFF

' 标题
'title 图4.4 系统ER图

' 实体样式
skinparam entity {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
}

' 菱形关系样式
skinparam diamond {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

' ===== 定义实体 =====
entity "用户" as User {
    * UserId : bigint <<PK>>
    --
    用户名 : varchar
    手机号 : varchar
    密码 : varchar
    个人描述 : text
}

entity "权限管理信息" as Role {
    * RoleId : bigint <<PK>>
    --
    角色名称 : varchar
    权限描述 : text
}

entity "古木信息" as Tree {
    * TreeId : bigint <<PK>>
    --
    树种名称 : varchar
    树龄 : int
    树高 : varchar
    描述信息 : text
    latitude : decimal(10,8)
    longitude : decimal(11,8)
}

entity "图像信息" as Image {
    * Id : bigint <<PK>>
    --
    TreeId : bigint <<FK>>
    存储路径 : varchar
    hash_code : varchar(128)
    hash_bits : binary(16)
}

' ===== 定义关系 =====
entity "属于" as BelongsTo <<diamond>> #FFF9C4
entity "管理" as ManageTree <<diamond>> #FFF9C4
entity "拥有" as Owns <<diamond>> #FFF9C4
entity "管理图像" as ManageImage <<diamond>> #FFF9C4

' ===== 关系连接 =====
User ||--|| BelongsTo
BelongsTo ||--o{ Role

User ||--|| ManageTree
ManageTree ||--o{ Tree

Tree ||--|| Owns
Owns ||--o{ Image

User ||--|| ManageImage
ManageImage ||--o{ Image

' ===== 注释 =====
note right of Image
图像信息表：
- hash_code: 128位哈希码字符串
- hash_bits: 16字节二进制存储
end note

note bottom of Tree
树木表位置字段：
- latitude: 纬度(-90~90)
- longitude: 经度(-180~180)
- 采用WGS84坐标系
end note

@enduml
