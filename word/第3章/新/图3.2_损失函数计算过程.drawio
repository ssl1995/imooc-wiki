<mxfile host="Electron" agent="Mozilla/5.0" version="29.6.6">
  <diagram name="图3.2 损失函数计算过程" id="loss-function">
    <mxGraphModel dx="1434" dy="836" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 标题 -->
        <mxCell id="title" value="&lt;b&gt;图3.2 双阶段损失优化策略计算过程&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="600" height="40" as="geometry" />
        </mxCell>
        
        <!-- 输入 -->
        <mxCell id="input" value="&lt;b&gt;输入样本&lt;/b&gt;&#xa;(预测概率 p,&#xa;真实标签 p*)" style="rounded=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="120" height="70" as="geometry" />
        </mxCell>
        
        <!-- 第一阶段 Focal Loss -->
        <mxCell id="focal_stage" value="&lt;b&gt;第一阶段：Focal Loss&lt;/b&gt;&#xa;&#xa;L&lt;sub&gt;FL&lt;/sub&gt; = -α&lt;sub&gt;t&lt;/sub&gt;(1-p&lt;sub&gt;t&lt;/sub&gt;)&lt;sup&gt;γ&lt;/sup&gt; log(p&lt;sub&gt;t&lt;/sub&gt;)&#xa;&#xa;• γ=2.0 聚焦参数&#xa;• α&lt;sub&gt;t&lt;/sub&gt; 类别权重&#xa;• 降低易分样本权重&#xa;• 关注难分样本" style="rounded=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="280" y="80" width="240" height="140" as="geometry" />
        </mxCell>
        
        <!-- 第二阶段 GHM -->
        <mxCell id="ghm_stage" value="&lt;b&gt;第二阶段：GHM梯度均衡&lt;/b&gt;&#xa;&#xa;g = |p - p*|&#xa;GD(g) = 梯度密度统计&#xa;β&lt;sub&gt;i&lt;/sub&gt; = N / GD(g&lt;sub&gt;i&lt;/sub&gt;)&#xa;&#xa;• ε=0.05 区间宽度&#xa;• 动态调整样本权重&#xa;• 抑制异常样本影响" style="rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="280" y="260" width="240" height="150" as="geometry" />
        </mxCell>
        
        <!-- 梯度计算 -->
        <mxCell id="gradient" value="&lt;b&gt;梯度计算&lt;/b&gt;&#xa;g = |p - p*|&#xa;梯度模长" style="rounded=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="600" y="150" width="130" height="70" as="geometry" />
        </mxCell>
        
        <!-- 梯度密度统计 -->
        <mxCell id="gd_stats" value="&lt;b&gt;梯度密度统计&lt;/b&gt;&#xa;10个区间划分&#xa;统计各区间样本数" style="rounded=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="600" y="260" width="130" height="80" as="geometry" />
        </mxCell>
        
        <!-- 权重计算 -->
        <mxCell id="weight_calc" value="&lt;b&gt;权重系数计算&lt;/b&gt;&#xa;β = N / GD(g)&#xa;(样本总数/梯度密度)" style="rounded=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="800" y="200" width="150" height="80" as="geometry" />
        </mxCell>
        
        <!-- 最终损失 -->
        <mxCell id="final_loss" value="&lt;b&gt;最终加权损失&lt;/b&gt;&#xa;&#xa;L&lt;sub&gt;total&lt;/sub&gt; = β × L&lt;sub&gt;FL&lt;/sub&gt;&#xa;&#xa;均衡后的损失函数" style="rounded=1;fillColor=#C8E6C9;strokeColor=#1B5E20;strokeWidth=3;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="1000" y="180" width="150" height="100" as="geometry" />
        </mxCell>
        
        <!-- 边缘案例 -->
        <mxCell id="edge_cases" value="&lt;b&gt;样本分类&lt;/b&gt;&#xa;&#xa;易分样本: g→0&#xa;  (降低权重)&#xa;&#xa;难分样本: g→0.5&#xa;  (增加权重)&#xa;&#xa;异常样本: g→1&#xa;  (抑制影响)" style="rounded=1;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=2;strokeDasharray=5,5;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="800" y="350" width="130" height="140" as="geometry" />
        </mxCell>
        
        <!-- 连接线 -->
        <mxCell id="e1" style="endArrow=classic;strokeWidth=2;strokeColor=#424242" edge="1" parent="1" source="input" target="focal_stage">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="185" />
              <mxPoint x="200" y="150" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="e2" style="endArrow=classic;strokeWidth=2;strokeColor=#424242" edge="1" parent="1" source="input" target="ghm_stage">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="185" />
              <mxPoint x="200" y="335" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="e3" style="endArrow=classic;strokeWidth=2;strokeColor=#424242" edge="1" parent="1" source="focal_stage" target="gradient">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e4" style="endArrow=classic;strokeWidth=2;strokeColor=#424242" edge="1" parent="1" source="gradient" target="gd_stats">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e5" style="endArrow=classic;strokeWidth=2;strokeColor=#424242" edge="1" parent="1" source="ghm_stage" target="weight_calc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="560" y="335" />
              <mxPoint x="560" y="240" />
              <mxPoint x="800" y="240" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="e6" style="endArrow=classic;strokeWidth=2;strokeColor=#424242" edge="1" parent="1" source="gd_stats" target="weight_calc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="300" />
              <mxPoint x="750" y="240" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="e7" style="endArrow=classic;strokeWidth=3;strokeColor=#1565C0" edge="1" parent="1" source="weight_calc" target="final_loss">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e8" style="endArrow=classic;strokeWidth=1;strokeColor=#EF6C00;strokeDasharray=3,3;fontSize=10" edge="1" parent="1" source="edge_cases" target="weight_calc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- 阶段标注 -->
        <mxCell id="stage1_label" value="&lt;b&gt;阶段一&lt;/b&gt;&#xa;初次加权" style="text;strokeColor=none;fillColor=none;align=center;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="220" y="110" width="60" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="stage2_label" value="&lt;b&gt;阶段二&lt;/b&gt;&#xa;二次筛分" style="text;strokeColor=none;fillColor=none;align=center;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="220" y="300" width="60" height="40" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
