          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- CBAM到融合 -->
        <mxCell id="edge7" value="" style="endArrow=classic;strokeWidth=2;strokeColor=#424242" edge="1" parent="1" source="cbam_block" target="fusion_block">
