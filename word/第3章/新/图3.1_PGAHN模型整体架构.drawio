        <!-- 图例 -->
        <mxCell id="legend" value="&lt;b&gt;模块说明：&lt;/b&gt;&#xa;PNAS: 渐进式神经架构搜索&#xa;CBAM: 卷积块注意力模块&#xa;Focal Loss: 聚焦损失函数&#xa;GHM: 梯度调和机制" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10" vertex="1" parent="1">
