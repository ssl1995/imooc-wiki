          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- 到特征链 -->
        <mxCell id="e10" style="endArrow=classic;strokeWidth=2;strokeColor=#C62828" edge="1" parent="1" source="channel_weight" target="feature_chain">
