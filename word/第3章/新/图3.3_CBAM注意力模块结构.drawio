        <!-- 空间模块内部 -->
        <mxCell id="e7" style="endArrow=classic;strokeWidth=1;strokeColor=#424242" edge="1" parent="1" source="channel_avg" target="conv7x7">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="790" y="295" />
