        <mxCell id="e6" style="endArrow=classic;strokeWidth=1;strokeColor=#424242" edge="1" parent="1" source="sigmoid" target="channel_weight">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="340" />
