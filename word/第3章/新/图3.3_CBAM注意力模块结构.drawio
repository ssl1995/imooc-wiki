<mxfile host="Electron" agent="Mozilla/5.0" version="29.6.6">
  <diagram name="图3.3 CBAM模块结构" id="cbam-structure">
    <mxGraphModel dx="1434" dy="836" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 标题 -->
        <mxCell id="title" value="&lt;b&gt;图3.3 CBAM卷积块注意力模块结构&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="600" height="40" as="geometry" />
        </mxCell>
        
        <!-- 输入特征图 -->
        <mxCell id="input_feature" value="&lt;b&gt;输入特征图 F&lt;/b&gt;&#xa;C × H × W&#xa;(通道×高×宽)" style="rounded=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="500" y="80" width="140" height="70" as="geometry" />
        </mxCell>
        
        <!-- 通道注意力模块 -->
        <mxCell id="channel_attention_box" value="" style="rounded=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=3;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="480" height="280" as="geometry" />
        </mxCell>
        
        <mxCell id="channel_title" value="&lt;b&gt;通道注意力模块 (Channel Attention)&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;align=center;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="90" y="210" width="300" height="30" as="geometry" />
        </mxCell>
        
        <!-- 全局池化 -->
        <mxCell id="avg_pool" value="&lt;b&gt;全局平均池化&lt;/b&gt;&#xa;AvgPool&#xa;1 × 1 × C" style="rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="120" y="260" width="100" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="max_pool" value="&lt;b&gt;全局最大池化&lt;/b&gt;&#xa;MaxPool&#xa;1 × 1 × C" style="rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="120" y="360" width="100" height="70" as="geometry" />
        </mxCell>
        
        <!-- MLP -->
        <mxCell id="mlp_shared" value="&lt;b&gt;共享MLP&lt;/b&gt;&#xa;• FC: C → C/r&#xa;• ReLU&#xa;• FC: C/r → C&#xa;(r=16压缩比)" style="rounded=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="280" y="280" width="120" height="120" as="geometry" />
        </mxCell>
        
        <!-- Sigmoid -->
        <mxCell id="sigmoid" value="&lt;b&gt;Sigmoid&lt;/b&gt;&#xa;激活函数" style="rounded=1;fillColor=#FFF9C4;strokeColor=#F9A825;strokeWidth=2;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="450" y="310" width="80" height="60" as="geometry" />
        </mxCell>
        
        <!-- 通道权重 -->
        <mxCell id="channel_weight" value="&lt;b&gt;通道权重 M&lt;sub&gt;c&lt;/sub&gt;&lt;/b&gt;&#xa;1 × 1 × C" style="rounded=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="430" y="420" width="120" height="50" as="geometry" />
        </mxCell>
        
        <!-- 空间注意力模块 -->
        <mxCell id="spatial_attention_box" value="" style="rounded=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=3;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="620" y="200" width="480" height="280" as="geometry" />
        </mxCell>
        
        <mxCell id="spatial_title" value="&lt;b&gt;空间注意力模块 (Spatial Attention)&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;align=center;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="630" y="210" width="300" height="30" as="geometry" />
        </mxCell>
        
        <!-- 通道池化 -->
        <mxCell id="channel_avg" value="&lt;b&gt;通道平均池化&lt;/b&gt;&#xa;AvgPool&#xa;H × W × 1" style="rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="660" y="260" width="100" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="channel_max" value="&lt;b&gt;通道最大池化&lt;/b&gt;&#xa;MaxPool&#xa;H × W × 1" style="rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="660" y="360" width="100" height="70" as="geometry" />
        </mxCell>
        
        <!-- 卷积 -->
        <mxCell id="conv7x7" value="&lt;b&gt;7×7卷积&lt;/b&gt;&#xa;• Conv2d&#xa;• BatchNorm&#xa;• Sigmoid" style="rounded=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="820" y="285" width="100" height="110" as="geometry" />
        </mxCell>
        
        <!-- 空间权重 -->
        <mxCell id="spatial_weight" value="&lt;b&gt;空间权重 M&lt;sub&gt;s&lt;/sub&gt;&lt;/b&gt;&#xa;H × W × 1" style="rounded=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="960" y="315" width="120" height="50" as="geometry" />
        </mxCell>
        
        <!-- 特征优化链 -->
        <mxCell id="feature_chain" value="&lt;b&gt;特征优化链&lt;/b&gt;&#xa;&#xa;F' = M&lt;sub&gt;c&lt;/sub&gt;(F) ⊗ F&#xa;(通道加权)&#xa;&#xa;F'' = M&lt;sub&gt;s&lt;/sub&gt;(F') ⊗ F'&#xa;(空间加权)&#xa;&#xa;输出增强特征 F''" style="rounded=1;fillColor=#C8E6C9;strokeColor=#1B5E20;strokeWidth=3;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="350" y="530" width="440" height="140" as="geometry" />
        </mxCell>
        
        <!-- 输出 -->
        <mxCell id="output_feature" value="&lt;b&gt;输出特征图 F''&lt;/b&gt;&#xa;C × H × W&#xa;(增强后特征)" style="rounded=1;fillColor=#D1C4E9;strokeColor=#4527A0;strokeWidth=3;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="500" y="720" width="140" height="70" as="geometry" />
        </mxCell>
        
        <!-- 连接线 -->
        <!-- 输入到通道注意力 -->
        <mxCell id="e1" style="endArrow=classic;strokeWidth=2;strokeColor=#424242" edge="1" parent="1" source="input_feature" target="channel_attention_box">
