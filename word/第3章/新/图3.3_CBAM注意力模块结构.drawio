        <!-- 说明文字 -->
        <mxCell id="desc" value="&lt;b&gt;CBAM工作机制：&lt;/b&gt;&#xa;1. 通道注意力：学习'什么'是有意义的特征&#xa;2. 空间注意力：学习'哪里'是关注区域&#xa;3. 两模块串联形成特征优化链&#xa;4. 自适应增强关键特征，抑制背景干扰" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="80" y="530" width="240" height="100" as="geometry" />
