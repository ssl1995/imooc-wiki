        </mxCell>
        
        <!-- 通道模块内部 -->
        <mxCell id="e3" style="endArrow=classic;strokeWidth=1;strokeColor=#424242" edge="1" parent="1" source="avg_pool" target="mlp_shared">
          <mxGeometry relative="1" as="geometry">
