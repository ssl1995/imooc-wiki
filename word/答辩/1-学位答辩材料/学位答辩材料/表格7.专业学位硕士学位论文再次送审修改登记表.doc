                            <w:pPr>
                                <w:jc w:val="left" />
                                <w:rPr>
                                    <w:rFonts w:fareast="宋体" w:hint="default" />
                                    <w:sz w:val="24" />
                                    <w:lang w:val="EN-US" w:fareast="ZH-CN" />
                                </w:rPr>
