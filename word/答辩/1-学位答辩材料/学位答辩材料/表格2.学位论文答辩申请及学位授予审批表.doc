                        </w:p>
                        <w:p>
                            <w:pPr>
                                <w:spacing w:before="312" w:before-lines="100" />
                                <w:ind w:first-line="4200" w:first-line-chars="2000" />
                                <w:rPr>
                                    <w:rFonts w:hint="fareast" />
