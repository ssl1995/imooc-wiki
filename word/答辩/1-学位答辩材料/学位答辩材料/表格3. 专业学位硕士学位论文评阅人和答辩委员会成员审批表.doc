                                <w:spacing w:before="156" w:before-lines="50" w:after="156" w:after-lines="50" />
                                <w:rPr>
                                    <w:rFonts w:hint="fareast" />
                                    <w:sz w:val="24" />
                                </w:rPr>
                            </w:pPr>
                            <w:r>
                                <w:rPr>
                                    <w:rFonts w:hint="fareast" />
                                    <w:b />
                                    <w:b-cs />
                                    <w:sz w:val="24" />
                                </w:rPr>
                                <w:t>不少于7名</w:t>
                            </w:r>
                            <w:r>
                                <w:rPr>
                                    <w:rFonts w:hint="fareast" />
                                    <w:sz w:val="24" />
                                </w:rPr>
                                <w:t>,教授或相当职称,其中至少4名应是博士生导师，2名是本校和申请人单位以外的专家。推荐人、导师不能做评阅人。</w:t>
                            </w:r>
                        </w:p>
                    </w:tc>
                </w:tr>
            </w:tbl>
            <w:p>
                <w:pPr>
                    <w:tabs>
                        <w:tab w:val="left" w:pos="5400" />
                    </w:tabs>
                    <w:spacing w:before="156" w:before-lines="50" w:after="156" w:after-lines="50" />
                    <w:rPr>
                        <w:rFonts w:hint="fareast" />
                        <w:sz w:val="24" />
                    </w:rPr>
                </w:pPr>
            </w:p>
            <w:p>
                <w:pPr>
                    <w:tabs>
                        <w:tab w:val="left" w:pos="5400" />
                    </w:tabs>
                    <w:spacing w:before="156" w:before-lines="50" w:after="156" w:after-lines="50" />
                    <w:rPr>
                        <w:rFonts w:hint="fareast" />
                        <w:sz w:val="24" />
