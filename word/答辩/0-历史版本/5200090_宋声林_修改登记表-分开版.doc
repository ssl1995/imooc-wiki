s New Roman" w:hint="fareast"/><w:sz w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="24"/></w:rPr><w:t>签署意见</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="8404" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="auto"/><w:noWrap w:val="0"/><w:vAlign w:val="top"/></w:tcPr><w:p><w:pPr><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="default"/><w:sz w:val="24"/></w:rPr></w:pPr></w:p><w:p><w:pPr><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="default"/><w:sz w:val="24"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="24"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>  </w:t></w:r></w:p><w:p><w:pPr><w:ind w:first-line="480" w:first-line-chars="200"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="24"/></w:rPr></w:pPr></w:p><w:p><w:pPr><w:ind w:first-line="480" w:first-line-chars="200"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="24"/></w:rPr></w:pPr></w:p><w:p><w:pPr><w:ind w:first-line="840" w:first-line-chars="350"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="24"/></w:rPr><w:t>导师签名：                         年   月   日</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p><w:pPr><w:spacing w:before="156" w:before-lines="50"/><w:rPr><w:rFonts w:hint="fareast"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="fareast"/></w:rPr><w:t>注：1）本表可加页；用5号宋体打印，存档；</w:t></w:r></w:p><w:p><w:pPr><w:ind w:first-line="420" w:first-line-chars="200"/><w:rPr><w:rFonts w:hint="fareast"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="fareast"/></w:rPr><w:t>2）</w:t></w:r><w:r><w:t>“</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="fareast"/></w:rPr><w:t>修改意见</w:t></w:r><w:r><w:t>”</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="fareast"/></w:rPr><w:t>一栏应详细填写评阅或答辩委员所提意见，并按顺序标明</w:t></w:r><w:r><w:t>“</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/></w:rPr><w:t>①②③</w:t></w:r><w:r><w:t>”</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="fareast"/></w:rPr><w:t>；</w:t></w:r></w:p><w:p><w:pPr><w:ind w:first-line="420" w:first-line-chars="200"/><w:rPr><w:rFonts w:hint="fareast"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="fareast"/></w:rPr><w:t>3）</w:t></w:r><w:r><w:t>“</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="fareast"/></w:rPr><w:t>修改结果</w:t></w:r><w:r><w:t>”</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="fareast"/></w:rPr><w:t>一栏应详细标明本人按意见修改结果和页码；对不进行修改的意见需要作详细说明；</w:t></w:r></w:p><w:p><w:pPr><w:ind w:first-line="420" w:first-line-chars="200"/><w:rPr><w:rFonts w:hint="fareast"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="fareast"/></w:rPr><w:t>4）本表应在本人签字及导师进行详细、全面、认真签署意见后生效；</w:t></w:r></w:p><w:p><w:pPr><w:ind w:first-line="420" w:first-line-chars="200"/><w:rPr><w:rFonts w:hint="fareast"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="fareast"/></w:rPr><w:t>5）答辩后未做修改或敷衍修改者不得提交学位会。如因没有进行修改而产生的一切后果责任自负。</w:t></w:r></w:p><w:sectPr><w:pgSz w:w="11907" w:h="16840"/><w:pgMar w:top="964" w:right="1134" w:bottom="964" w:left="1304" w:header="794" w:footer="907" w:gutter="0"/><w:cols w:space="720"/><w:docGrid w:type="lines" w:line-pitch="312"/></w:sectPr></wx:sect></w:body></w:wordDocument>