rwidth="10" w:space="0" w:color="auto"/><w:insideH w:val="single" w:sz="4" wx:bdrwidth="10" w:space="0" w:color="auto"/><w:insideV w:val="single" w:sz="4" wx:bdrwidth="10" w:space="0" w:color="auto"/></w:tblBorders><w:tblCellMar><w:top w:w="0" w:type="dxa"/><w:left w:w="108" w:type="dxa"/><w:bottom w:w="0" w:type="dxa"/><w:right w:w="108" w:type="dxa"/></w:tblCellMar></w:tblPr><w:tblGrid><w:gridCol w:w="1604"/><w:gridCol w:w="8404"/></w:tblGrid><w:tr><w:tblPrEx><w:tblBorders><w:top w:val="single" w:sz="4" wx:bdrwidth="10" w:space="0" w:color="auto"/><w:left w:val="single" w:sz="4" wx:bdrwidth="10" w:space="0" w:color="auto"/><w:bottom w:val="single" w:sz="4" wx:bdrwidth="10" w:space="0" w:color="auto"/><w:right w:val="single" w:sz="4" wx:bdrwidth="10" w:space="0" w:color="auto"/><w:insideH w:val="single" w:sz="4" wx:bdrwidth="10" w:space="0" w:color="auto"/><w:insideV w:val="single" w:sz="4" wx:bdrwidth="10" w:space="0" w:color="auto"/></w:tblBorders><w:tblCellMar><w:top w:w="0" w:type="dxa"/><w:left w:w="108" w:type="dxa"/><w:bottom w:w="0" w:type="dxa"/><w:right w:w="108" w:type="dxa"/></w:tblCellMar></w:tblPrEx><w:trPr><w:trHeight w:val="2156" w:h-rule="atLeast"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="1604" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="auto"/><w:noWrap w:val="0"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="24"/></w:rPr><w:t>评阅人所提修改意见</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="8404" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="auto"/><w:noWrap w:val="0"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:b/><w:b-cs/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:b/><w:b-cs/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>一、论文题目、摘要中存在的问题</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>1. 论文摘要的内容需要整理（中文摘要/英文摘要部分）。摘要首段将核心问题表述为“图像与地理位置元数据割裂、单模态检索精度不足”，但后续又出现“复杂背景干扰”等背景问题，两者问题粒度与角度不同，且未在摘要中明确模型改进原因及思考，导致“改的内容”与“针对问题”之间描述割裂、逻辑性不强。（评阅人4）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>2. 部分专业术语界定不严谨，存在前后表述不一致问题，需加强全文术语统一性；建议在第2章开头或摘要相关位置增加术语界定段落，明确“图像数据/图像特征”“位置坐标/地理位置元数据”等核心概念的边界与用法。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:b/><w:b-cs/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:b/><w:b-cs/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>二、文章结构与逻辑类问题</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>1. 第2章内容过多，需要精简。建议将AlexNet、VGG、EfficientNet、ViT等通用图像编码器基础知识前移至第2章2.1.2节（现代卷积神经网络，目录第11页/正文约第14页）并精简描述；第3章3.2.2节（图像与位置特征编码，目录第27页/正文约第30页）应集中介绍本文实际采用的ResNet-50与LocationEncoder，避免与第2章重复。（评阅人1、评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>2. 1.2.2节“多模态融合与地理位置元数据研究现状”末尾两段（目录第3页/正文约第6页）与该节标题主旨关联不强，过于冗余，建议删除或合并入其他段落。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>3. 3.2.2节（图像与位置特征编码，目录第27页/正文约第30页）描述层次不够清晰，应明确划分为“图像特征编码”和“位置特征编码”两个子层次；建议将原3.2.3节（多模态融合层，目录第28页/正文约第31页）中的地理位置元数据编码内容迁移至3.2.2节，3.2.3节专注多模态融合策略介绍。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>4. 第4章标题（目录第54页/正文约第57页）应与正文保持一致，建议统一为“4 古树名木多模态检索系统研建”，并同步更新目录与页眉。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>5. 古树名木多模态检索系统功能不够完善（4.1.1功能需求分析，目录第54页/正文约第57页；4.2.2系统功能模块设计，目录第59页/正文约第62页；4.3系统详细设计与实现，目录第64页/正文约第67页）。目前系统主要支持输入位置坐标或上传图像的检索模式，缺乏按科、属、种等基本检索功能，系统工程量较为单薄，更像演示系统，建议补充多维查询与数据管理功能，提升系统完整性。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>6. 论文关于系统设计内容存在一定漏洞，例如4.2.3节“数据库设计”（目录第61页/正文约第64页）中有关时间字段的设计需补充说明，明确字段类型、时区基准及更新机制。（评阅人4）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>7. 论文模型创新性较弱，系统设计和实现工作量较少，整体工作量不足。建议充实第3章模型设计（3.1引言，目录第24页/正文约第27页；3.2.1模型总体结构，目录第25页/正文约第28页）与第4章系统实现内容，突出研究的完整性与深度。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:b/><w:b-cs/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:b/><w:b-cs/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>三、实验、数据与结论严谨类问题</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>1. 基线对比均为单模态方法（HashNet、DCH、MDSH），缺少多模态哈希方法实验对比。在3.4.1节“对比模型选择”（目录第43页/正文约第46页）和3.4.2节“对比实验结果”（目录第46页/正文约第49页）中，现有多模态哈希方法（如DCMH、SSAH）虽面向图像-文本跨模态检索、文本编码器不直接适用于地理位置坐标，但可考虑改造其编码器以适配位置坐标输入，或与GeoCLIP等图像-位置对比学习方法进行对比，以增强外部参照系。（评阅人1、评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>2. 3.3.1节“iNaturalist 2018数据集”（目录第35页/正文约第38页）需明确说明：如何从iNaturalist 2018中筛选“古树名木相关子集”（36类相关类别的具体筛选标准）；iNaturalist中众包数据是否真实包含“古树名木”（树龄≥100年）样本，还是仅为“与古树名木所属科属相关”的普通植物样本；位置坐标的GPS精度是否满足古树名木地理位置元数据要求；摘要中提到的约13%样本缺失坐标的处理方式；以及数据集具体获取来源与植物位置信息使用情况。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>3. 自建BFATH数据集规模偏小。3.3.2节“BFATH自建数据集”（目录第37页/正文约第40页）显示该数据集仅300张样本（训练集240张/验证集30张/测试集30张），覆盖15个树种，平均每类不足20张；在3.4.3节“消融实验”（目录第51页/正文约第54页）中，30张测试样本对15个类别的检索性能评估统计显著性有限。建议扩充BFATH数据集规模，或至少通过K折交叉验证、多次随机划分重复实验报告均值与标准差，以增强消融实验结论的可信度。（评阅人1、评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>4. 3.2.4节“哈希层”（目录第29页/正文约第32页）未充分体现对深度哈希技术的创新。DHLAM模型虽融合图像特征和位置特征编码，但该节仅介绍哈希层实现流程，建议补充投影结构选择、连续松弛函数选择、哈希码长度与量化约束策略等设计决策依据，以体现创新性。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>5. 模型命名与实际方案不符。3.2.1节“模型总体结构”（目录第25页/正文约第28页）将DHLAM解释为“Deep Hashing Learning Adaptive Multi-modal Network”，但3.2.3节“多模态融合层”（目录第28页/正文约第31页）明确主模型采用特征拼接，注意力加权融合仅作为备选方案且未在实验中验证，主模型并未包含真正的Adaptive机制。建议统一模型命名与实验方案表述，避免名实不符。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>6. 3.3.4节“评价指标”（目录第40页/正文约第43页）中mAP计算方式需明确：是按查询样本排序列表计算AP，还是按类别计算AP；是否对检索结果进行分类。同时，Recall@K指标中“数据集含36个类别，测试集1245张，平均每类约34.6张”的表述与前文数据集规模不符，需核对修正。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>7. 3.4.1节“对比模型选择”（目录第43页/正文约第46页）第一段末尾提及“本论文报告单次运行的实验结果”，该表述不够严谨科学，建议补充固定随机种子、多次验证或稳定性说明。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>8. 3.2.6节“检索流程”（目录第33页/正文约第36页）与3.3.4节“评价指标”（目录第40页/正文约第43页）中，双向检索评价策略需明确：依据位置查询图像（L2I）时，输入位置信息是自然语言描述还是GPS定位；该情形下图像特征未参与查询，需说明L2I检索的相关性定义、检索半径设置与完整流程。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>9. 论文模型创新工作量有限，3.2节“模型结构”中采用的多模态融合解决方案较为传统，建议进一步突出模型创新性与差异性；同时可将3.3.2节“BFATH自建数据集”（目录第37页/正文约第40页）的数据集构建工作单独成节，作为独立工作量呈现。（评阅人4）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:b/><w:b-cs/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:b/><w:b-cs/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>四、公式、图表及语言表达规范类问题</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>1. 图1.1（1.3节“研究内容与技术路线”，评阅老师所指第6页/目录第4页/正文约第6页）中，三部分研究内容所在框格需用箭头等连接起来以表明三者关系；图中留白过多、字体过小，建议重新设计绘图，提高清晰度。（评阅人2）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>2. 图2.6（2.1.2节“现代卷积神经网络”，评阅老师所指第14页/目录第11页/正文约第14页）题注文字应为“样本”，而非“相本”。（评阅人2）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>3. 在介绍“多模态融合”等基本概念时（2.3.1节“多模态识别”或2.3.2节“多模态融合技术”，目录第17-18页/正文约第20-21页），缺乏文献引用，建议补充相关引用。（评阅人2）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>4. 公式3-17（3.2.5节“损失函数”，评阅老师所指第34页/目录第31页/正文约第34页）中，三个损失权重的具体取值需说明确定依据；公式中参数定义建议归一化，对应3.4.4节“超参数敏感性分析”（目录第52页/正文约第55页）同步规范。（评阅人2、评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>5. 3.2.4节“哈希层”（目录第29页/正文约第32页）存在明显AI痕迹，双引号标点使用不当；公式（3-10）字体格式不对，公式（3-16）缺乏说明，公式（3-18）取值范围有误（检索向量均为非负值），需统一修正。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:ind w:left-chars="0"/><w:jc w:val="both"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="24"/></w:rPr></w:pPr></w:p></w:tc></w:tr><w:tr><w:tblPrEx><w:tblBorders><w:top w:val="single" w:sz="4" wx:bdrwidth="10" w:space="0" w:color="auto"/><w:left w:val="single" w:sz="4" wx:bdrwidth="10" w:space="0" w:color="auto"/><w:bottom w:val="single" w:sz="4" wx:bdrwidth="10" w:space="0" w:color="auto"/><w:right w:val="single" w:sz="4" wx:bdrwidth="10" w:space="0" w:color="auto"/><w:insideH w:val="single" w:sz="4" wx:bdrwidth="10" w:space="0" w:color="auto"/><w:insideV w:val="single" w:sz="4" wx:bdrwidth="10" w:space="0" w:color="auto"/></w:tblBorders><w:tblCellMar><w:top w:w="0" w:type="dxa"/><w:left w:w="108" w:type="dxa"/><w:bottom w:w="0" w:type="dxa"/><w:right w:w="108" w:type="dxa"/></w:tblCellMar></w:tblPrEx><w:trPr><w:trHeight w:val="1872" w:h-rule="atLeast"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="1604" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="auto"/><w:noWrap w:val="0"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="24"/></w:rPr><w:t>修改结果</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="24"/></w:rPr><w:t>及说明</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="8404" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="auto"/><w:noWrap w:val="0"/><w:vAlign w:val="top"/></w:tcPr><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:b/><w:b-cs/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:b/><w:b-cs/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>一、论文题目、摘要中存在的问题</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>1. 论文摘要的内容需要整理（中文摘要/英文摘要部分）。摘要首段将核心问题表述为“图像与地理位置元数据割裂、单模态检索精度不足”，但后续又出现“复杂背景干扰”等背景问题，两者问题粒度与角度不同，且未在摘要中明确模型改进原因及思考，导致“改的内容”与“针对问题”之间描述割裂、逻辑性不强。（评阅人4）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>回复：已重新整理摘要首段，将核心问题统一为“图像与地理位置元数据割裂、单模态检索精度不足”，删除“复杂背景干扰”作为摘要顶层问题的表述，将其下放到第3章数据预处理等具体章节；在摘要中明确模型改进原因，说明本文“融合图像与地理位置元数据构建统一哈希空间，利用位置先验缓解形态相似树种的视觉歧义，实现以图搜图、以图搜位置和以位置搜图的多模态检索能力”，以体现地理位置元数据对单模态图像检索的互补价值。</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>2. 部分专业术语界定不严谨，存在前后表述不一致问题，需加强全文术语统一性；建议在第2章开头或摘要相关位置增加术语界定段落，明确“图像数据/图像特征”“位置坐标/地理位置元数据”等核心概念的边界与用法。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>回复：已在第2章开头新增术语界定段，明确“图像数据指原始像素矩阵及文件级输入；图像特征指经由卷积神经网络提取的高维向量表示”；全文已统一替换“图像信息”为“图像特征/图像数据”，替换“视觉信息”为“图像特征”，并统一了“地理位置元数据”“位置坐标”等核心术语的表述。</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:b/><w:b-cs/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:b/><w:b-cs/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>二、文章结构与逻辑类问题</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>1. 第2章内容过多，需要精简。建议将AlexNet、VGG、EfficientNet、ViT等通用图像编码器基础知识前移至第2章2.1.2节（现代卷积神经网络，目录第11页/正文约第14页）并精简描述；第3章3.2.2节（图像与位置特征编码，目录第27页/正文约第30页）应集中介绍本文实际采用的ResNet-50与LocationEncoder，避免与第2章重复。（评阅人1、评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>回复：已对第2章进行精简，将AlexNet、dropout、Xavier、ViT、EfficientNet等基础内容从3.2.2节前移至2.1.2节并精简描述；将LocationEncoder内容并入3.2.2节，删除3.2.3节位置编码的重复说明，调整章节层次结构，使第3章集中介绍本文实际采用的ResNet-50与LocationEncoder。</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>2. 1.2.2节“多模态融合与地理位置元数据研究现状”末尾两段（目录第3页/正文约第6页）与该节标题主旨关联不强，过于冗余，建议删除或合并入其他段落。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>回复：已删除1.2.2节末尾以“综上所述”开头的总结性段落，避免与该节标题主旨无关的冗余内容。</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>3. 3.2.2节（图像与位置特征编码，目录第27页/正文约第30页）描述层次不够清晰，应明确划分为“图像特征编码”和“位置特征编码”两个子层次；建议将原3.2.3节（多模态融合层，目录第28页/正文约第31页）中的地理位置元数据编码内容迁移至3.2.2节，3.2.3节专注多模态融合策略介绍。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>回复：已将LocationEncoder内容并入3.2.2节，使该节明确分为“图像特征编码”和“位置特征编码”两个子层次；3.2.3节改为专注多模态融合策略介绍，删除冗余小标题内容。</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>4. 第4章标题（目录第54页/正文约第57页）应与正文保持一致，建议统一为“4 古树名木多模态检索系统研建”，并同步更新目录与页眉。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>回复：经与导师沟通，为准确反映系统功能，已将第4章标题统一为“4 古树名木多模态展示与检索系统”，并同步更新了目录和页眉。</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>5. 古树名木多模态检索系统功能不够完善（4.1.1功能需求分析，目录第54页/正文约第57页；4.2.2系统功能模块设计，目录第59页/正文约第62页；4.3系统详细设计与实现，目录第64页/正文约第67页）。目前系统主要支持输入位置坐标或上传图像的检索模式，缺乏按科、属、种等基本检索功能，系统工程量较为单薄，更像演示系统，建议补充多维查询与数据管理功能，提升系统完整性。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>回复：已在4.1.1节补充系统支持科属种三级级联查询、树种名称模糊查询、保护级别筛选和树龄区间筛选等功能描述；在4.2.2节功能模块设计中增加古树名木信息查询模块（含科属种查询与树种名称查询）；在4.3节新增4.3.1古树名木数据上传设计与实现、4.3.2古树名木信息查询设计与实现，新增图4.5到图4.9，使系统从单一多模态检索扩展为展示查询与多模态检索的综合平台。</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>6. 论文关于系统设计内容存在一定漏洞，例如4.2.3节“数据库设计”（目录第61页/正文约第64页）中有关时间字段的设计需补充说明，明确字段类型、时区基准及更新机制。（评阅人4）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>回复：已在4.2.3末尾补充数据库时间字段说明：所有时间字段采用bigint类型存储Unix毫秒时间戳，并以UTC为时间基准，避免跨国部署可能带来的时区问题；时间类型的相互转化和插入更新由应用层代码负责，同时可新增数据库环境支持的时间自动触发器更新时间，降低与应用层代码的耦合。</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>7. 论文模型创新性较弱，系统设计和实现工作量较少，整体工作量不足。建议充实第3章模型设计（3.1引言，目录第24页/正文约第27页；3.2.1模型总体结构，目录第25页/正文约第28页）与第4章系统实现内容，突出研究的完整性与深度。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>回复：已在3.2.1节末尾新增“与现有工作的区别与设计动机”段落，系统阐述DHLM与HashNet、DCH、MDSH等单模态深度哈希方法的区别，强调图像-地理位置元数据这一特殊双模态场景下的LocationEncoder设计、特征拼接策略选择及三损失联合优化的针对性；在3.2.4节补充哈希层投影结构选择、连续松弛函数选择、哈希码长度与量化约束策略等设计决策依据；第4章补充系统功能模块与详细设计，充实系统实现内容。</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:b/><w:b-cs/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:b/><w:b-cs/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>三、实验、数据与结论严谨类问题</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>1. 基线对比均为单模态方法（HashNet、DCH、MDSH），缺少多模态哈希方法实验对比。在3.4.1节“对比模型选择”（目录第43页/正文约第46页）和3.4.2节“对比实验结果”（目录第46页/正文约第49页）中，现有多模态哈希方法（如DCMH、SSAH）虽面向图像-文本跨模态检索、文本编码器不直接适用于地理位置坐标，但可考虑改造其编码器以适配位置坐标输入，或与GeoCLIP等图像-位置对比学习方法进行对比，以增强外部参照系。（评阅人1、评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>回复：已在3.4.1节说明DCMH、SSAH等现有多模态哈希方法是图像-文本编码器，其中文本编码器与地理位置坐标在输入格式、语义空间和编码方式上存在差异，无法直接迁移构成公平对比；在3.4.2节对比实验设计了单模态变体做公平对照和多模态增益验证说明，补充了DHLM与GeoCLIP在任务目标（预测vs检索）上的差异化定位；在第5章对多模态哈希方法的实验对比做了展望说明。受限于时间关系与计算资源，与多模态哈希方法对比留作后续研究。</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>2. 3.3.1节“iNaturalist 2018数据集”（目录第35页/正文约第38页）需明确说明：如何从iNaturalist 2018中筛选“古树名木相关子集”（36类相关类别的具体筛选标准）；iNaturalist中众包数据是否真实包含“古树名木”（树龄≥100年）样本，还是仅为“与古树名木所属科属相关”的普通植物样本；位置坐标的GPS精度是否满足古树名木地理位置元数据要求；摘要中提到的约13%样本缺失坐标的处理方式；以及数据集具体获取来源与植物位置信息使用情况。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>回复：已在3.3.1节补充说明：筛选标准为依据《古树名木普查技术规范》及京津冀地区常见古树名木科属分布，通过family（科）字段筛选出25个相关科属类别；明确iNaturalist为通用植物数据集，图像采集场景与真实古树名木记录存在差异，定位为“预训练与通用评估数据集”；位置坐标精度为消费级定位精度，满足城市/景区级位置检索需求；缺失坐标处理方式为剔除坐标缺失或明显异常的记录；明确本研究使用该数据集中的植物图像及其对应的位置坐标构建训练样本。</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>3. 自建BFATH数据集规模偏小。3.3.2节“BFATH自建数据集”（目录第37页/正文约第40页）显示该数据集仅300张样本（训练集240张/验证集30张/测试集30张），覆盖15个树种，平均每类不足20张；在3.4.3节“消融实验”（目录第51页/正文约第54页）中，30张测试样本对15个类别的检索性能评估统计显著性有限。建议扩充BFATH数据集规模，或至少通过K折交叉验证、多次随机划分重复实验报告均值与标准差，以增强消融实验结论的可信度。（评阅人1、评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>回复：已在3.3.1节、3.4.1节和3.4.3节补充说明：BFATH数据集小样本的合理性论证，古树名木为不可再生资源，受保护政策限制，300张已属稀缺资源；明确数据集职能定位，iNaturalist 2018承担核心性能对比、融合策略对比与消融实验，BFATH承担领域微调验证与系统演示；为增强消融实验的统计稳健性，消融实验在iNaturalist 2018验证集（2509张）上进行。受时间限制未执行专家建议的K折交叉验证。</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>4. 3.2.4节“哈希层”（目录第29页/正文约第32页）未充分体现对深度哈希技术的创新。DHLAM模型虽融合图像特征和位置特征编码，但该节仅介绍哈希层实现流程，建议补充投影结构选择、连续松弛函数选择、哈希码长度与量化约束策略等设计决策依据，以体现创新性。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>回复：已在3.2.4节增加三方面论证：投影结构选择、连续松弛函数选择、哈希码长度与量化约束策略，系统展示哈希层各组件的设计决策依据，不再仅描述实现流程。</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>5. 模型命名与实际方案不符。3.2.1节“模型总体结构”（目录第25页/正文约第28页）将DHLAM解释为“Deep Hashing Learning Adaptive Multi-modal Network”，但3.2.3节“多模态融合层”（目录第28页/正文约第31页）明确主模型采用特征拼接，注意力加权融合仅作为备选方案且未在实验中验证，主模型并未包含真正的Adaptive机制。建议统一模型命名与实验方案表述，避免名实不符。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>回复：已将模型名称从DHLAM（Deep Hashing Learning Adaptive Multi-modal）更改为DHLM（Deep Hashing Learning Multi-modal Network），图3.1模型架构图同步更新为DHLM模型架构；在3.2.3节通过多路融合策略验证（特征拼接、门控融合、逐元素相加、逐元素相乘四种方案对比实验，见表3.6）确定特征拼接为最优融合方案，而非直接声明使用特征拼接。</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>6. 3.3.4节“评价指标”（目录第40页/正文约第43页）中mAP计算方式需明确：是按查询样本排序列表计算AP，还是按类别计算AP；是否对检索结果进行分类。同时，Recall@K指标中“数据集含36个类别，测试集1245张，平均每类约34.6张”的表述与前文数据集规模不符，需核对修正。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>回复：已在3.3.4节明确mAP计算方式：按查询样本的排序列表计算AP；将“36类/1245张”修正为“25个古树名木相关类别/1254张”，并重新核对了每类平均样本量的表述。</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>7. 3.4.1节“对比模型选择”（目录第43页/正文约第46页）第一段末尾提及“本论文报告单次运行的实验结果”，该表述不够严谨科学，建议补充固定随机种子、多次验证或稳定性说明。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>回复：已将3.4.1节相关表述修改为“为客观地评估...本节在两个数据集上开展分层实验”；在第5章补充说明“实验验证层面，本文采用固定随机种子（seed=42）下的单次运行并报告结果，核心结论已通过预实验多次验证”。</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>8. 3.2.6节“检索流程”（目录第33页/正文约第36页）与3.3.4节“评价指标”（目录第40页/正文约第43页）中，双向检索评价策略需明确：依据位置查询图像（L2I）时，输入位置信息是自然语言描述还是GPS定位；该情形下图像特征未参与查询，需说明L2I检索的相关性定义、检索半径设置与完整流程。（评阅人3）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>回复：已在3.3.4节说明“以地理位置坐标为查询，检索半径＜1km等距离的图像视为相关样本”，并在3.2.6节补充L2I检索流程的详细说明；在第4章系统描述中明确L2I输入为“位置坐标”，输出为附近图像列表。</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>9. 论文模型创新工作量有限，3.2节“模型结构”中采用的多模态融合解决方案较为传统，建议进一步突出模型创新性与差异性；同时可将3.3.2节“BFATH自建数据集”（目录第37页/正文约第40页）的数据集构建工作单独成节，作为独立工作量呈现。（评阅人4）</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr><w:t>回复：已在3.2.1节末尾新增“与现有工作的区别与设计动机”段落，突出DHLM在图像-地理位置元数据双模态场景下的创新性；将原3.3.1节拆分为“3.3.1 iNaturalist 2018数据集”和“3.3.2 BFATH自建数据集”两个并列小节，系统说明BFATH的数据来源、构建流程、规模划分、字段说明与使用边界，体现数据集构建的独立工作量；在3.3.2末尾新增表3.1数据集对比，并在5.1总结部分补充BFATH数据集作为领域验证数据资源的贡献。</w:t></w:r></w:p><w:p><w:pPr><w:keepNext w:val="off"/><w:keepLines w:val="off"/><w:pageBreakBefore w:val="off"/><w:widowControl/><w:supressLineNumbers w:val="off"/><w:kinsoku/><w:wordWrap/><w:overflowPunct/><w:topLinePunct w:val="off"/><w:autoSpaceDE/><w:autoSpaceDN/><w:adjustRightInd/><w:snapToGrid/><w:spacing w:after="0" w:line="300" w:line-rule="auto"/><w:jc w:val="left"/><w:textAlignment w:val="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:fareast="宋体" w:cs="Times New Roman" w:hint="fareast"/><w:sz w:val="21"/><w:sz-cs w:val="21"/><w:lang w:val="EN-US" w:fareast="ZH-CN"/></w:rPr></w:pPr></w: